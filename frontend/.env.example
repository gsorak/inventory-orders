# Backend API location, inlined into the bundle at build time (restart Expo / rebuild after changing it).
# Local development: the Spring Boot backend (CORS allows http://localhost:8081).
#   Web / iOS simulator: http://localhost:8080, Android emulator: http://10.0.2.2:8080
# Same-origin deployment (e.g. CloudFront routing /api/* to the backend): set it empty to use relative /api/... URLs.
# If unset, development uses http://localhost:8080 and production builds use relative URLs.
EXPO_PUBLIC_API_URL=http://localhost:8080
