# Copy to .env (gitignored) and adjust:  cp .env.example .env
# Used by compose.yaml (database container) and start-dev.sh (application).
# Never commit real credentials.
# The credentials are applied only when the database volume is first created;
# after changing them, recreate it with: docker compose down -v

DB_USERNAME=appuser
DB_PASSWORD=changeme

# Host port of the PostgreSQL container (5433 avoids clashing with a local PostgreSQL on 5432).
DB_PORT=5433
# JDBC URL used by the application; keep the port in sync with DB_PORT.
DB_URL=jdbc:postgresql://localhost:5433/inventory
